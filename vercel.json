{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npm run install:frontends",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth" },
    { "source": "/api/wiki/:path*", "destination": "/api/wiki" },
    { "source": "/api/contabilidad/:path*", "destination": "/api/contabilidad" },
    { "source": "/api/diagramas/:path*", "destination": "/api/diagramas" },
    { "source": "/api/roadmap/:path*", "destination": "/api/roadmap" },
    { "source": "/roadmap", "destination": "/roadmap/index.html" },
    { "source": "/roadmap/", "destination": "/roadmap/index.html" },
    { "source": "/diagramas", "destination": "/diagramas/index.html" },
    { "source": "/diagramas/", "destination": "/diagramas/index.html" },
    { "source": "/diagramas/:path*", "destination": "/diagramas/index.html" },
    { "source": "/contabilidad", "destination": "/contabilidad/index.html" },
    { "source": "/contabilidad/", "destination": "/contabilidad/index.html" },
    { "source": "/contabilidad/:path*", "destination": "/contabilidad/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ]
}
