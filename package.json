{
  "name": "tu-broki-apps",
  "version": "1.0.0",
  "private": true,
  "description": "Herramientas internas de TuBroki: un launcher, un backend compartido y una app por carpeta (apps/<slug>).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install:frontends": "npm install --prefix apps/roadmap/frontend --include=dev && npm install --prefix apps/diagramas/frontend --include=dev && npm install --prefix apps/contabilidad/frontend --include=dev",
    "build": "node scripts/build.mjs",
    "build:static": "node scripts/build.mjs --skip-vite",
    "build:roadmap": "npm run build --prefix apps/roadmap/frontend",
    "build:diagramas": "npm run build --prefix apps/diagramas/frontend",
    "build:contabilidad": "npm run build --prefix apps/contabilidad/frontend",
    "dev": "node scripts/dev.mjs",
    "smoke:wiki": "node scripts/smoke-wiki.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "mcp:token": "node scripts/mcp-crear-token.mjs",
    "mcp:revoke": "node scripts/mcp-revocar-token.mjs",
    "smoke:diagramas-flow": "node scripts/smoke-diagramas-flow.mjs",
    "seed:wiki": "node scripts/seed-wiki-ejemplos.mjs",
    "seed:wiki-docs": "node scripts/seed-wiki-documentos.mjs",
    "seed:contabilidad": "node scripts/seed-contabilidad.mjs",
    "import:wiki-vault": "CONFIRM_WIPE=1 node scripts/import-vault-wiki.mjs",
    "import:wiki-vault:resume": "RESUME=1 node scripts/import-vault-wiki.mjs",
    "wiki:dedupe-aliases": "node scripts/wiki-dedupe-aliases.mjs",
    "dev:roadmap": "npm run dev --prefix apps/roadmap/frontend",
    "dev:diagramas": "npm run dev --prefix apps/diagramas/frontend",
    "dev:contabilidad": "npm run dev --prefix apps/contabilidad/frontend",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "postinstall": "prisma generate",
    "db:generate": "node scripts/prisma-env.mjs generate",
    "db:pull": "node scripts/prisma-env.mjs db pull",
    "db:migrate": "node scripts/prisma-env.mjs migrate dev",
    "db:deploy": "node scripts/prisma-env.mjs migrate deploy",
    "db:status": "node scripts/prisma-env.mjs migrate status",
    "db:studio": "node scripts/prisma-env.mjs studio",
    "db:resolve": "node scripts/prisma-env.mjs migrate resolve"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.117.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
