# Copia este archivo a .env.local (local) y configura lo mismo en Vercel → Settings → Environment Variables.

# Supabase · proyecto compartido "tubroki-apps" · rol de mínimo privilegio tubroki_apps
# Runtime (Prisma Client): transaction pooler :6543 + pgbouncer=true (Vercel sin IPv6).
DATABASE_URL=postgresql://tubroki_apps.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3

# Migraciones Prisma: session pooler :5432 (mismo user del pooler). Evitar db.*.supabase.co si no hay IPv6.
DIRECT_URL=postgresql://tubroki_apps.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Auth OTP (mismo proyecto tubroki-apps)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=cambia-esta-anon-key

# Correos con acceso total (coma-separados, minúsculas recomendadas)
APPS_ALLOWED_EMAILS=edwardfigueroavelasco@gmail.com,soporte@tubroki.com,mayralejandrarm@hotmail.com,andreapatino305@gmail.com

# Secreto para firmar la cookie de sesión. Genera uno: openssl rand -hex 32
SESSION_SECRET=cambia-este-secreto

# MCP Wiki (Bearer tbw_…)
# Secreto HMAC para URLs firmadas de assets (si vacío usa SESSION_SECRET)
MCP_DOWNLOAD_SECRET=
# Opcional; si vacío usa APPS_ALLOWED_EMAILS
MCP_ALLOWED_EMAILS=
# URL pública del endpoint MCP (docs + firmas en prod)
# MCP_PUBLIC_URL=https://<deploy>.vercel.app/api/mcp
