# Copia este archivo a .env.local (local) y configura lo mismo en Vercel → Settings → Environment Variables.

# Supabase · proyecto compartido "tubroki-apps" · rol de mínimo privilegio tubroki_apps
# Usa el transaction pooler (puerto 6543): Vercel no tiene IPv6 y el host directo db.*.supabase.co lo exige.
DATABASE_URL=postgresql://tubroki_apps.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Clave compartida para entrar a las apps (pantalla /acceso)
APPS_PASSWORD=cambia-esta-clave

# Secreto para firmar la cookie de sesión. Genera uno: openssl rand -hex 32
SESSION_SECRET=cambia-este-secreto
